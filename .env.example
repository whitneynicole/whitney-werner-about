# Canonical site URL for sitemap.xml, robots.txt, canonical and og:image.
# Optional: on Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is unset.
SITE_URL=https://example.com
# Set by Vercel at build time; listed here for completeness, do not set by hand.
# VERCEL_PROJECT_PRODUCTION_URL=example.vercel.app
